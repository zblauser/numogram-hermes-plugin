(export (version "E")
  (design
    (source "sensor-hub.kicad_sch")
    (tool "Eeschema 8.0.6")
    (sheet (number "1") (name "/") (tstamps "/")
      (title_block (title "sensor-hub") (rev "A"))))
  (components
    (comp (ref "U1") (value "ESP32-C3-MINI-1") (footprint "RF_Module:ESP32-C3-MINI-1")
      (libsource (lib "RF_Module") (part "ESP32-C3-MINI-1") (description "RF Module, ESP32-C3 SoC, Wi-Fi 802.11b/g/n, Bluetooth LE"))
      (sheetpath (names "/") (tstamps "/")))
    (comp (ref "U2") (value "SHTC3") (footprint "Sensor_Humidity:Sensirion_DFN-4-1EP_2x2mm_P1mm_EP0.7x1.6mm")
      (libsource (lib "Sensor_Humidity") (part "SHTC3") (description "Humidity and temperature sensor, I2C")))
    (comp (ref "R1") (value "4.7k") (footprint "Resistor_SMD:R_0402_1005Metric"))
    (comp (ref "R2") (value "4.7k") (footprint "Resistor_SMD:R_0402_1005Metric"))
    (comp (ref "R3") (value "1k") (footprint "Resistor_SMD:R_0402_1005Metric"))
    (comp (ref "R4") (value "1k") (footprint "Resistor_SMD:R_0402_1005Metric"))
    (comp (ref "R5") (value "10k") (footprint "Resistor_SMD:R_0402_1005Metric"))
    (comp (ref "D1") (value "LED") (footprint "LED_SMD:LED_0603_1608Metric"))
    (comp (ref "Q1") (value "MMBT3904") (footprint "Package_TO_SOT_SMD:SOT-23"))
    (comp (ref "BZ1") (value "Buzzer") (footprint "Buzzer_Beeper:MagneticBuzzer_CUI_CMT-8504-100-SMT"))
    (comp (ref "SW1") (value "BOOT") (footprint "Button_Switch_SMD:SW_SPST_PTS810"))
    (comp (ref "J1") (value "USB_C_Receptacle_USB2.0") (footprint "Connector_USB:USB_C_Receptacle_GCT_USB4105-xx-A_16P_TopMnt_Horizontal"))
    (comp (ref "C1") (value "10u") (footprint "Capacitor_SMD:C_0603_1608Metric")))
  (nets
    (net (code "1") (name "+3V3") (class "Default")
      (node (ref "U1") (pin "3") (pinfunction "3V3") (pintype "power_in"))
      (node (ref "U2") (pin "1") (pinfunction "VDD") (pintype "power_in"))
      (node (ref "R1") (pin "1") (pintype "passive"))
      (node (ref "R2") (pin "1") (pintype "passive"))
      (node (ref "R5") (pin "1") (pintype "passive"))
      (node (ref "C1") (pin "1") (pintype "passive")))
    (net (code "2") (name "GND") (class "Default")
      (node (ref "U1") (pin "1") (pinfunction "GND") (pintype "power_in"))
      (node (ref "U2") (pin "2") (pinfunction "VSS") (pintype "power_in"))
      (node (ref "D1") (pin "1") (pinfunction "K") (pintype "passive"))
      (node (ref "Q1") (pin "2") (pinfunction "E") (pintype "passive"))
      (node (ref "SW1") (pin "2") (pintype "passive"))
      (node (ref "C1") (pin "2") (pintype "passive")))
    (net (code "3") (name "/I2C_SDA") (class "Default")
      (node (ref "U1") (pin "17") (pinfunction "IO5") (pintype "bidirectional"))
      (node (ref "U2") (pin "4") (pinfunction "SDA") (pintype "bidirectional"))
      (node (ref "R1") (pin "2") (pintype "passive")))
    (net (code "4") (name "/I2C_SCL") (class "Default")
      (node (ref "U1") (pin "16") (pinfunction "IO4") (pintype "bidirectional"))
      (node (ref "U2") (pin "3") (pinfunction "SCL") (pintype "input"))
      (node (ref "R2") (pin "2") (pintype "passive")))
    (net (code "5") (name "/STATUS_LED") (class "Default")
      (node (ref "U1") (pin "27") (pinfunction "IO8") (pintype "bidirectional"))
      (node (ref "R3") (pin "1") (pintype "passive")))
    (net (code "6") (name "Net-(D1-A)") (class "Default")
      (node (ref "R3") (pin "2") (pintype "passive"))
      (node (ref "D1") (pin "2") (pinfunction "A") (pintype "passive")))
    (net (code "7") (name "/BOOT") (class "Default")
      (node (ref "U1") (pin "28") (pinfunction "IO9") (pintype "bidirectional"))
      (node (ref "SW1") (pin "1") (pintype "passive"))
      (node (ref "R5") (pin "2") (pintype "passive")))
    (net (code "8") (name "/BUZZER") (class "Default")
      (node (ref "U1") (pin "23") (pinfunction "IO10") (pintype "bidirectional"))
      (node (ref "R4") (pin "1") (pintype "passive")))
    (net (code "9") (name "Net-(Q1-B)") (class "Default")
      (node (ref "R4") (pin "2") (pintype "passive"))
      (node (ref "Q1") (pin "1") (pinfunction "B") (pintype "input")))
    (net (code "10") (name "Net-(BZ1-+)") (class "Default")
      (node (ref "Q1") (pin "3") (pinfunction "C") (pintype "passive"))
      (node (ref "BZ1") (pin "1") (pinfunction "+") (pintype "passive")))
    (net (code "11") (name "/USB_D-") (class "Default")
      (node (ref "U1") (pin "30") (pinfunction "IO18") (pintype "bidirectional"))
      (node (ref "J1") (pin "A7") (pinfunction "D-") (pintype "bidirectional")))
    (net (code "12") (name "/USB_D+") (class "Default")
      (node (ref "U1") (pin "31") (pinfunction "IO19") (pintype "bidirectional"))
      (node (ref "J1") (pin "A6") (pinfunction "D+") (pintype "bidirectional")))
    (net (code "13") (name "unconnected-(U1-IO2-Pad5)") (class "Default")
      (node (ref "U1") (pin "5") (pinfunction "IO2") (pintype "bidirectional+no_connect")))))
